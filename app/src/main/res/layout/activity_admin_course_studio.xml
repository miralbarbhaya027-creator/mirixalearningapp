<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFF">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:tint="@color/text_dark" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/btn_back"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_top_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Python Prog..."
                    android:textColor="@color/text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/card_background"
                    android:backgroundTint="#F5F2FF"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="CONTENT"
                    android:textColor="@color/accent_purple"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mirixa Admin Console"
                android:textColor="@color/text_light"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_profile_top"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person"
                android:background="@color/primary_blue"
                android:padding="8dp" />
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>

    <!-- Main Scroll View -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_studio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_admin"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="32dp">

            <!-- Breadcrumb & Header Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Catalog › "
                    android:textColor="@color/text_light"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tv_crumb_course"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[ Python Programming ]"
                    android:textColor="@color/text_dark"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" › Content Blueprint"
                    android:textColor="@color/primary_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <TextView
                    android:id="@+id/tv_header_course_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[ Course Title Slot ]"
                    android:textColor="@color/text_dark"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_blueprint_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/card_background"
                    android:backgroundTint="#FFEBEE"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="Incomplete"
                    android:textColor="@color/error_red"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Schema initialized. Provisioning live content modules."
                android:textColor="@color/text_light"
                android:textSize="12sp" />

            <!-- Section 1: Course Overview (Blueprint) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Course Overview (Blueprint)"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Thumbnail Asset Selector -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_thumbnail_box"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#F8FAFF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/primary_blue">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/iv_studio_banner_preview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/app_logo" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:gravity="center"
                                android:background="#B3000000"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="8dp"
                                android:orientation="vertical">
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_sparkle"
                                    app:tint="@color/white" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Tap to Select / Change Course Thumbnail"
                                    android:textColor="@color/white"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="COURSE TITLE SLOT"
                        android:textColor="@color/text_light"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/et_studio_title"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/card_background"
                        android:backgroundTint="#F8FAFF"
                        android:paddingHorizontal="12dp"
                        android:hint="[ Course Title: e.g. Python Programming ]"
                        android:textSize="13sp"
                        android:inputType="text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="COURSE IMAGE KEY / DRAWABLE"
                        android:textColor="@color/text_light"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/et_studio_img_url"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/card_background"
                        android:backgroundTint="#F8FAFF"
                        android:paddingHorizontal="12dp"
                        android:hint="e.g. course_python, course_react, course_kotlin"
                        android:textSize="13sp"
                        android:inputType="text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="CURRICULUM SCOPE / SYNOPSIS"
                        android:textColor="@color/text_light"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/et_studio_desc"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/card_background"
                        android:backgroundTint="#F8FAFF"
                        android:gravity="top|start"
                        android:padding="12dp"
                        android:hint="[ Course Overview Description ]"
                        android:textSize="13sp"
                        android:inputType="textMultiLine" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_overview"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/primary_blue"
                        android:text="Configure Overview Details"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: Video Lecture Stream -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Video Lecture"
                            android:textColor="@color/text_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_video_linked_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/card_background"
                            android:backgroundTint="#F1F4FF"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Video Linked"
                            android:textColor="@color/primary_blue"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Dark Video Stream Frame -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="#1A2238"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:gravity="center"
                                android:orientation="vertical">
                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_module_video"
                                    app:tint="@color/white" />
                                <TextView
                                    android:id="@+id/tv_video_stream_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Video Stream Authenticated"
                                    android:textColor="@color/white"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentTop="true"
                                android:background="#33FFFFFF"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="15:00"
                                android:textColor="@color/white"
                                android:textSize="10sp" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="ENDPOINT / STREAM URL"
                        android:textColor="@color/text_light"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/et_studio_video_url"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/card_background"
                        android:backgroundTint="#F8FAFF"
                        android:paddingHorizontal="12dp"
                        android:hint="[ Video Stream URL: e.g. https://www.youtube.com/watch?v=rfscVS0vtbw ]"
                        android:textSize="13sp"
                        android:inputType="textUri" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_preview_video"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="Preview Stream"
                            android:textAllCaps="false"
                            app:cornerRadius="10dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_save_video"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/primary_blue"
                            android:text="+ Add Video"
                            android:textAllCaps="false"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: PDF / Curriculum Notes -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PDF / Curriculum Notes"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="PDF ASSET ENDPOINT URL"
                        android:textColor="@color/text_light"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/et_studio_pdf_url"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/card_background"
                        android:backgroundTint="#F8FAFF"
                        android:paddingHorizontal="12dp"
                        android:hint="[ PDF Document Slot: e.g. python_notes.pdf ]"
                        android:textSize="13sp"
                        android:inputType="textUri" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_topic"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:text="+ Add Topic to Syllabus"
                        android:textAllCaps="false"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 4: Mind Map Architecture -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mind Map Architecture"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Concept Graph Frame -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="#F0F4FF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_sparkle"
                                app:tint="@color/primary_blue" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Interactive Knowledge Graph Nodes (x, y)"
                                android:textColor="@color/text_medium"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="MIND MAP DRAWABLE / GRAPHIC KEY"
                        android:textColor="@color/text_light"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_studio_mindmap_img"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/card_background"
                        android:backgroundTint="#F8FAFF"
                        android:paddingHorizontal="12dp"
                        android:hint="e.g. mindmap_python, mindmap_java, mindmap_js"
                        android:textSize="13sp"
                        android:inputType="text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_select_mindmap_drawable"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:text="🗺️ Select Mind Map Drawable Graphic (res/drawable)"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_edit"
                        app:iconSize="14dp" />

                    <EditText
                        android:id="@+id/et_mindmap_node_label"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/card_background"
                        android:backgroundTint="#F8FAFF"
                        android:paddingHorizontal="12dp"
                        android:hint="[ Node Label Slot: e.g. Core Principles ]"
                        android:textSize="13sp"
                        android:inputType="text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_mindmap_node"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/primary_blue"
                        android:text="+ Add Mind Map Node"
                        android:textAllCaps="false"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 4: Quiz Assessment Builder -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quiz Assessment Builder"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_quiz_question"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/card_background"
                        android:backgroundTint="#F8FAFF"
                        android:paddingHorizontal="12dp"
                        android:hint="[ Question Prompt Slot: e.g. What is Python? ]"
                        android:textSize="13sp"
                        android:inputType="text" />

                    <EditText
                        android:id="@+id/et_quiz_opt0"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/card_background"
                        android:backgroundTint="#F8FAFF"
                        android:paddingHorizontal="12dp"
                        android:hint="A [ Option A Slot: e.g. Programming Language ]"
                        android:textSize="13sp"
                        android:inputType="text" />

                    <EditText
                        android:id="@+id/et_quiz_opt1"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/card_background"
                        android:backgroundTint="#F8FAFF"
                        android:paddingHorizontal="12dp"
                        android:hint="B [ Option B Slot: e.g. Database Engine ]"
                        android:textSize="13sp"
                        android:inputType="text" />

                    <EditText
                        android:id="@+id/et_quiz_opt2"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/card_background"
                        android:backgroundTint="#F8FAFF"
                        android:paddingHorizontal="12dp"
                        android:hint="C [ Option C Slot: e.g. Operating System ]"
                        android:textSize="13sp"
                        android:inputType="text" />

                    <EditText
                        android:id="@+id/et_quiz_opt3"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/card_background"
                        android:backgroundTint="#F8FAFF"
                        android:paddingHorizontal="12dp"
                        android:hint="D [ Option D Slot: e.g. Web Browser ]"
                        android:textSize="13sp"
                        android:inputType="text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="CORRECT ANSWER INDEX (0 = A, 1 = B, 2 = C, 3 = D)"
                        android:textColor="@color/text_light"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_quiz_correct_index"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/card_background"
                        android:backgroundTint="#F8FAFF"
                        android:paddingHorizontal="12dp"
                        android:hint="Correct Index: 0 for A, 1 for B, 2 for C, 3 for D"
                        android:textSize="13sp"
                        android:inputType="number"
                        android:text="0" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_quiz_question"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/primary_blue"
                        android:text="+ Add First Question"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Footer Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_discard_draft"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Discard Blueprint"
                    android:textAllCaps="false"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_blueprint_draft"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary_blue"
                    android:text="Save Blueprint Draft"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:cornerRadius="14dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_nav_admin"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:cardElevation="24dp"
        app:cardCornerRadius="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp">

            <!-- 1. Overview -->
            <LinearLayout
                android:id="@+id/nav_admin_dashboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_home"
                    app:tint="@color/text_light" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Overview"
                    android:textColor="@color/text_light"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 2. Users -->
            <LinearLayout
                android:id="@+id/nav_admin_users"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/text_light" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Users"
                    android:textColor="@color/text_light"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 3. Categories -->
            <LinearLayout
                android:id="@+id/nav_admin_category"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_categories"
                    app:tint="@color/text_light" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Categories"
                    android:textColor="@color/text_light"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 4. Courses (Active) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/nav_admin_courses"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.2"
                app:cardBackgroundColor="#E8EEFF"
                app:cardCornerRadius="23dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_book"
                        app:tint="@color/primary_blue" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Courses"
                        android:textColor="@color/primary_blue"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Settings -->
            <LinearLayout
                android:id="@+id/nav_admin_profile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_security"
                    app:tint="@color/text_light" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Settings"
                    android:textColor="@color/text_light"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>