<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose Avatar"
        android:textColor="@color/text_dark"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Avatar 1 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/avatar_1"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            app:cardBackgroundColor="#F0F2FF"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary_blue"
            app:strokeWidth="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@drawable/ic_person"
                app:tint="@color/primary_blue" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Avatar 2 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/avatar_2"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            app:cardBackgroundColor="#F0F2FF"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary_blue"
            app:strokeWidth="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@drawable/ic_school"
                app:tint="@color/primary_blue" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Avatar 3 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/avatar_3"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            app:cardBackgroundColor="#F0F2FF"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary_blue"
            app:strokeWidth="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@drawable/ic_bulb"
                app:tint="@color/primary_blue" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Avatar 4 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/avatar_4"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            app:cardBackgroundColor="#F0F2FF"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary_blue"
            app:strokeWidth="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@drawable/ic_star"
                app:tint="@color/primary_blue" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Avatar 5 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/avatar_5"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            app:cardBackgroundColor="#F0F2FF"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary_blue"
            app:strokeWidth="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/primary_blue" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>
